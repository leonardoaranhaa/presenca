# ─────────────────────────────────────────────────────────────
# Presença — variáveis de ambiente
#
# Sem VITE_: só o servidor lê. Nunca chegam ao browser.
# Com VITE_: são embebidas no bundle do cliente — nunca pôr segredos aqui.
# ─────────────────────────────────────────────────────────────

# ── IA (voz da presença: /api/chat e /api/awaken) ──
# Sem esta chave a app corre, mas a conversa responde 503 e a UI avisa.
# XAI_API_KEY=
# Modelo, opcional. Default: grok-4.5
# XAI_MODEL=grok-4.5
# Endpoint, opcional. Formato compatível com OpenAI — apontar a um proxy,
# self-host, ou stub local para testar o fluxo sem gastar no fornecedor.
# AI_API_URL=https://api.x.ai/v1/chat/completions

# ── ElevenLabs (voz memorial clonada) ──
# Sem esta chave a presença fala pelo leitor do aparelho (Web Speech API).
# ELEVENLABS_API_KEY=

# ── TURN (WebRTC) — servidor ──
# Credenciais temporárias, recomendado. O mesmo secret do coturn.
# TURN_URLS=turn:SEU_IP:3478
# TURN_SECRET=mesmo_secret_do_coturn
# TURN_TTL_SECONDS=3600
# Fallback estático (menos seguro — credenciais fixas não expiram):
# TURN_STATIC_USERNAME=
# TURN_STATIC_CREDENTIAL=

# ── TURN — cliente ──
# Só se não houver /api/turn/credentials. Ficam visíveis no bundle.
# VITE_TURN_URLS=turn:SEU_IP:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# ── PartyKit (multiplayer) ──
# Sem isto o multiplayer usa BroadcastChannel (abas do mesmo browser).
# VITE_PARTYKIT_HOST=presenca.seu-user.partykit.dev

# Embeddings semânticos (opcional — RAG híbrido BM25F + dense)
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# Ou, se o fornecedor xAI expuser embeddings:
# XAI_EMBEDDING_MODEL=

# Avatar 3D a partir de media (opcional)
#
# Sem estas duas, /api/status declara avatarMesh: false e o pedido devolve
# needs_provider já no POST — a família associa o GLB à mão. Com elas, o job
# passa a atravessar vários pedidos, e a fila em memória não sobrevive a
# serverless: ver 3.0b no PLANO.md antes de as pôr em produção.
# AVATAR_MESH_API_URL=https://api.meshy.ai
# AVATAR_MESH_API_KEY=
# AVATAR_MESH_PROVIDER=meshy
# AVATAR_MESH_TIMEOUT_MS=180000

# Segredo da equipa para completar um job studio com um GLB:
#   POST /api/avatar/jobs/:id  -H "authorization: Bearer <token>"
# Esse URL é carregado dentro do lar da família, por isso o endpoint recusa
# enquanto isto não estiver definido.
# AVATAR_ADMIN_TOKEN=

# LiveKit SFU (voz salas grandes)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecret
# Opcional no cliente (Vite):
# VITE_LIVEKIT_URL=ws://127.0.0.1:7880
